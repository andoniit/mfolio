# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://<your-project>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key — safe to expose, ships in the browser>
SUPABASE_SERVICE_ROLE_KEY=<service role key — SERVER ONLY, bypasses row-level security>

# --- Admin access (REQUIRED) ---
# Comma-separated emails allowed to write through /api. src/middleware.ts refuses
# every write unless the caller is signed in AND their email is on this list.
# Being signed in alone is not enough: Supabase signups are open, so anyone could
# create an account. Set this in .env.local AND in your production env (Vercel).
ADMIN_EMAILS=you@example.com

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Google Analytics ---
# The site's GA4 tag. Ships in the browser like any measurement id.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Read-only GA4 reporting for /api/admin/analytics (the iOS Analytics screen).
# Leave unset and that screen shows setup instructions instead of numbers.
#
# GA4_PROPERTY_ID is the NUMERIC property id from GA Admin → Property details —
# not the G-XXXX measurement id above.
#
# The service account comes from Google Cloud → IAM → Service Accounts → Keys
# (JSON). Enable the "Google Analytics Data API" on that project, then add the
# account's email as a Viewer in GA Admin → Property access management.
#
# SERVER ONLY. The private key never reaches the browser or the phone.
GA4_PROPERTY_ID=123456789
GOOGLE_SERVICE_ACCOUNT_EMAIL=mfolio-analytics@<project>.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Or, instead of the two lines above, paste the whole downloaded JSON (raw or
# base64) — easier in a Vercel env var, where multi-line values get mangled:
# GOOGLE_SERVICE_ACCOUNT_JSON=
